<?xml version="1.0" encoding="utf-8"?>
<!--
   Data extraction rules (Android 12+).
   The DataStore folder holds the JWT, so it is never copied
   to Google Drive or to a new device.
-->
<data-extraction-rules>
    <!-- Google Drive backup. Already disabled by allowBackup="false",
         kept here in case the flag is switched back to true. -->
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <!-- Direct transfer when setting up a new phone.
         Not disabled by allowBackup="false" on Android 12+. -->
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>